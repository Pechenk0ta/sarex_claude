# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Moscow       # used for working days and display
SECRET_KEY=change-me             # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_MAX_AGE_HOURS=12         # how long a login lasts

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=rd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rd
# Running the app outside docker (uv run ...): point to the dev DB directly
DATABASE_URL=postgresql+asyncpg://rd:change-me@localhost:5432/rd

# --- Server (production only) ---
APP_DOMAIN=rd.example.ru         # domain for HTTPS, served by Caddy

# --- Added in later stages (see docs/PLAN.md) ---
# Microsoft 365 mailbox (stage 4, 7)
# MAIL_ADDRESS=rd@company-domain.ru
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# YandexGPT (stage 7)
# CLASSIFIER=keywords            # keywords | yandexgpt
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_GPT_MODEL=yandexgpt-lite
# AI_CONFIDENCE_THRESHOLD=0.7
