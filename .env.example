# Copy to .env and fill in. Never commit .env.

# --- Application ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Moscow       # used for working days and display
SECRET_KEY=change-me             # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_MAX_AGE_HOURS=12         # how long a login lasts

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=rd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rd
# Running the app outside docker (uv run ...): point to the dev DB directly
DATABASE_URL=postgresql+asyncpg://rd:change-me@localhost:5432/rd

# --- Server (production only) ---
APP_DOMAIN=rd.example.ru         # domain for HTTPS, served by Caddy
APP_BASE_URL=http://localhost:8000   # public URL used in email links, e.g. https://rd.example.ru

# --- Deadlines (TZ 4.3) ---
DEADLINE_WORKDAYS=10
DEADLINE_HOUR=18                 # local time on the deadline day
FIRST_REMINDER_WORKDAYS=1        # reminders to contractors who have not answered (TZ 4.3)
SECOND_REMINDER_WORKDAYS=3
REMINDERS_HOUR=9                 # daily reminders/escalation job, local time; days off are skipped
REMINDERS_MINUTE=0

# --- System mailbox (TZ section 9, decision 1) ---
MAIL_ADDRESS=rd@company-domain.ru   # replies go to rd+<code>@company-domain.ru
MAIL_DISPLAY_NAME=Ознакомление с РД
# Development: docker compose sends to Mailpit automatically (see docker-compose.override.yml).
# Gmail; password = app password of the mailbox account (needs 2-step verification):
# MAIL_ADDRESS=rd.company@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SSL=false
# SMTP_STARTTLS=true
# SMTP_AUTH=password
# SMTP_PASSWORD=
# Microsoft 365 (not used now): SMTP_HOST=smtp.office365.com, SMTP_AUTH=oauth2,
# MS_TENANT_ID=, MS_CLIENT_ID=, MS_CLIENT_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_AUTH=none                   # none | oauth2 | password
MAIL_MAX_ATTEMPTS=5

# --- Added in later stages (see docs/PLAN.md) ---
# LLM for reply classification, Qwen3.5 Flash (stage 7; provider to be chosen)
# CLASSIFIER=keywords            # keywords | llm
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# AI_CONFIDENCE_THRESHOLD=0.7
